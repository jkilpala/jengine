          ]
        },
        "text": {
          "text": "The mixer is a tree of named buses. 'master' is the root; one-shots default to 'sfx' and music to 'music'.",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100
        }
      }
    },
    {
      "name": "Hint3",
      "components": {
        "transform": {
          "position": [
            -600.0,
            242.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "audio_create_bus(name, parent, volume) adds one; audio_remove_bus drops it. Volumes multiply down the chain.",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100
        }
      }
    },
    {
      "name": "Hint4",
      "components": {
        "transform": {
          "position": [
            -600.0,
            216.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "audio_set_bus_muted / _solo / _volume control a bus; audio_get_bus_volume and audio_is_bus_muted read it back.",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,

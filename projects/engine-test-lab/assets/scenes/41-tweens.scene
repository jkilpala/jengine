          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "A Tween component animates one property (PositionX/Y, Rotation, ScaleX/Y, Opacity) from -> to over duration.",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100
        }
      }
    },
    {
      "name": "Hint3",
      "components": {
        "transform": {
          "position": [
            -600.0,
            242.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "Ease picks the curve: Linear, EaseInQuad, EaseOutQuad, EaseInOutQuad. Watch the four rows start and stop differently.",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100
        }
      }
    },
    {
      "name": "Hint4",
      "components": {
        "transform": {
          "position": [
            -600.0,
            216.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "on_complete decides what happens at the end: Stop clamps, Loop restarts, PingPong swaps from/to and restarts.",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100
        }
      }
    },

  {
   "name": "Hint",
   "components": {
    "transform": {
     "position": [
      0.0,
      240.0
     ],
     "rotation": 0.0,
     "scale": [
      1.0,
      1.0
     ]
    },
    "text": {
     "text": "`anchor` is the point on the wheel; `anchor_b` is the mount on the chassis. Until Sep 2026 `Revolute` and `Prismatic` had only `anchor`, and the far end was hardcoded to the target's origin - so two wheels on one chassis both pinned to its middle. BUGS #145.",
     "font_id": "",
     "font_scale": 0.9,
     "color": [
      0.75,
      0.78,
      0.85,
      1
     ],
     "z_order": 100,
     "align": "center",
     "wrap_width": 1180.0
    }
   }
  },

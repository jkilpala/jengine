    {
      "name": "Hint2",
      "components": {
        "transform": {
          "position": [
            -600.0,
            268.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "Tags are runtime labels: add_tag / remove_tag / has_tag, and they are authored in the scene under \"tags\".",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100
        }
      }
    },
    {
      "name": "Hint3",
      "components": {
        "transform": {
          "position": [
            -600.0,
            242.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "find_by_tag(tag) returns one entity; get_entities_by_tag(tag) returns all of them.",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100
        }
      }
    },
    {
      "name": "Hint4",
      "components": {
        "transform": {
          "position": [
            -600.0,
            216.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "find_in_radius(x, y, radius) is the spatial query - it returns every entity within the circle.",
          "font_id": "",
          "font_scale": 1.0,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100

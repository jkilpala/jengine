    },
    {
      "name": "Hint1",
      "components": {
        "transform": {
          "position": [
            -600.0,
            288.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "Left: press 1 / 2 / 3 - the script send_events a number, and a graph's OnEvent turns it into brightness (arithmetic on a trigger's output).",
          "font_id": "",
          "font_scale": 0.85,
          "color": [
            1,
            1,
            1,
            1
          ],
          "z_order": 50
        }
      }
    },
    {
      "name": "Hint2",
      "components": {
        "transform": {
          "position": [
            -600.0,
            262.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "Middle: press K - the script despawns a pod; its graph's OnDespawn drops a ring WHERE IT WAS and emits pod_gone, which the script hears with x, y.",
          "font_id": "",
          "font_scale": 0.85,
          "color": [
            1,
            1,
            1,
            1
          ],
          "z_order": 50
        }
      }
    },
    {
      "name": "Hint3",
      "components": {
        "transform": {
          "position": [
            -600.0,
            236.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "Right: click anywhere - a graph reads OnMouseClick's SECOND output, the button: left turns the square green, right turns it red.",
          "font_id": "",
          "font_scale": 0.85,
          "color": [
            1,
            1,
            1,
            1
          ],
          "z_order": 50
        }
      }
    },
    {
      "name": "Hint4",
      "components": {
        "transform": {
          "position": [
            -600.0,
            210.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "Before Sep 2026 none of the three worked: no script ever reached a graph, a despawned graph read (0, 0), and only a trigger's first output could be wired.",

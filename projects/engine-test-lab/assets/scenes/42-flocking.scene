      }
    },
    {
      "name": "Hint4",
      "components": {
        "transform": {
          "position": [
            -600.0,
            260.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "Both run after seeking, so the crowd converges on the target without stacking into one sprite.",
          "font_id": "",
          "font_scale": 0.9,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100

        "transform": {
          "position": [
            -600.0,
            280.0
          ],
          "rotation": 0.0,
          "scale": [
            1.0,
            1.0
          ]
        },
        "text": {
          "text": "Obstacle is a static keep-out circle - resolve_obstacle_collisions pushes movers to its edge.",
          "font_id": "",
          "font_scale": 0.9,
          "color": [
            0.85,
            0.9,
            1.0,
            0.95
          ],
          "z_order": 100

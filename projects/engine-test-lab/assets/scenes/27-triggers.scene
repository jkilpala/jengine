    {
      "name": "Header",
      "components": {
        "transform": { "position": [-300.0, 320.0], "rotation": 0.0, "scale": [1.0, 1.0] },
        "text": { "text": "27 - TRIGGERS", "font_id": "", "font_scale": 2.5, "color": [1.0, 1.0, 1.0, 1.0], "z_order": 10 }
      }
    },
    {
      "name": "Hint1",
      "components": {
        "transform": { "position": [-580.0, 252.0], "rotation": 0.0, "scale": [1.0, 1.0] },
        "text": { "text": "TriggerArea2D + match_tags=[\"probe\"] - overlap state written to TriggerOverlaps each frame.", "font_id": "", "font_scale": 1.0, "color": [0.85, 0.9, 1.0, 1.0], "z_order": 10 }
      }
    },
    {
      "name": "Hint2",
      "components": {
        "transform": { "position": [-580.0, 226.0], "rotation": 0.0, "scale": [1.0, 1.0] },
        "text": { "text": "Probe wanders via Oscillator (Lissajous). Outlines drawn with VectorPath - zones are data-only.", "font_id": "", "font_scale": 1.0, "color": [0.85, 0.9, 1.0, 1.0], "z_order": 10 }
      }
    },
    {
      "name": "Hint3",
      "components": {
        "transform": { "position": [-580.0, 200.0], "rotation": 0.0, "scale": [1.0, 1.0] },
        "text": { "text": "Each zone script gets on_trigger_enter/exit (lines below); the probe tints white while inside.", "font_id": "", "font_scale": 0.9, "color": [0.7, 0.75, 0.85, 0.9], "z_order": 10 }
      }
    },

    {
      "name": "Probe",
      "components": {
        "transform": { "position": [0.0, 0.0], "rotation": 0.0, "scale": [1.0, 1.0] },
        "sprite": { "texture_id": "sprites/circle16.png", "color": [1.0, 0.95, 0.3, 1.0], "z_order": 5, "size": [36.0, 36.0] },
        "tags": ["probe"],
        "oscillator": { "amplitude": [480.0, 200.0], "frequency": [0.18, 0.27] },
        "script": { "language": "Lua", "source_path": "scripts/lua/trigger_probe.lua" }

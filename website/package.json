    "@tinacms/cli": "^1.6.0",
    "astro": "^5.7.0",
    "sharp": "^0.33.0",
    "tinacms": "^2.5.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }

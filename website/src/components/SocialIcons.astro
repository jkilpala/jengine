---
// The docs header's way back to the designed pages, before the social links.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<nav class="jx-docs-nav" aria-label="Site">
	<a href="/">Home</a>
	<a href="/#features">Features</a>
	<a href="/features/rendering/">Rendering</a>
	<a href="/#showcase">Showcase</a>
</nav>
<Default />

<style>
	.jx-docs-nav {
		display: flex;
		gap: 1.1rem;
		margin-inline-end: 0.75rem;
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}
	.jx-docs-nav a {
		color: var(--jx-muted);
		text-decoration: none;
	}
	.jx-docs-nav a:hover {
		color: var(--jx-link);
	}
	@media (max-width: 72rem) {
		.jx-docs-nav {
			display: none;
		}
	}
</style>

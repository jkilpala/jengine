# Rust
/target/
**/target/

# Node / Editor
editor/node_modules/
editor/dist/
editor/.svelte-kit/
editor/build/

# Tauri
editor/src-tauri/target/
editor/src-tauri/WixTools/
# Staged by build-editor-release.ps1: the stock viewport and engine source an installer ships.
editor/src-tauri/release-resources/

# WASM build output
crates/jengine-web/pkg/

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build output
build/
dist/
pkg/

# Website / Docs
website/node_modules/
website/dist/
website/.astro/
website/public/ai/

# Environment
.env
.env.local

# Per-project crates generated by jengine-builder so a project can link its own
# Rust packages: `.jengine/runtime/` for native builds, `.jengine/viewport/`
# for the editor, `.jengine/web/` for web builds, `.jengine/android/` for
# Android. All are rebuilt from
# project.jengine on every build, so committing them would only ever go stale.
projects/*/.jengine/runtime/
projects/*/.jengine/viewport/
projects/*/.jengine/web/
projects/*/.jengine/android/
# Test servers run from the editor (`jengine_builder::servers`): the local
# server's data, the local fleet agent's releases, and the tokens for both.
projects/*/.jengine/servers/
# Build & Run's instances: each one's saves and log (`jengine_builder::native_run`).
projects/*/.jengine/instances/

# Play data, written by running a game: best scores, where a party got to.
# Generated, per-machine, and not part of the project.
projects/arcade-classics/saves/
# The editor's per-project UI state (open tabs, panel sizes, build dirs) - personal
projects/*/editor-settings.json
# A game run from its project folder caches what it downloads and was told
# there: asset packs and the live ops answer (`asset::packs`, `liveops`).
projects/*/pack_cache/
projects/*/liveops_cache/

# Python byte-code from the asset generators under projects/*/tools/.
# One of these was committed by accident; it is machine- and
# interpreter-specific and nothing reads it.
__pycache__/
*.pyc

# Scratch output: build and test logs redirected to a file. 54 of these were
# committed at the root before this rule existed. Write them to a temp
# directory instead.
/*.txt
/*.log
/*.err
/*.out
/*.patch
projects/*/*.log
projects/*/*.err
projects/*/*.out

# Tool caches that were committed by accident
/.astro/
/node_modules/
